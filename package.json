{
  "name": "chorus3",
  "version": "3.0.13",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "package:kodi": "npm run build && npm run package:kodi:dist",
    "package:kodi:dist": "node scripts/package-kodi-webinterface.mjs",
    "install:kodi": "npm run package:kodi && rsync -ac --delete dist/kodi/webinterface.chorus3/ \"$HOME/Library/Application Support/Kodi/addons/webinterface.chorus3/\"",
    "package:kodi:repo": "npm run build && npm run package:kodi:repo:dist",
    "package:kodi:repo:dist": "node scripts/package-kodi-repository.mjs",
    "preview": "vite preview",
    "typecheck": "svelte-check --tsconfig ./tsconfig.app.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:kodi": "npm run smoke:kodi:http && npm run smoke:kodi:ws && npm run smoke:kodi:player-loop && npm run smoke:kodi:m003-media && npm run smoke:kodi:m004-video",
    "smoke:kodi:http": "node scripts/smoke-kodi-http.mjs",
    "smoke:kodi:ws": "node scripts/smoke-kodi-ws.mjs",
    "smoke:kodi:player-loop": "node scripts/smoke-player-loop.mjs",
    "smoke:kodi:m003-media": "node scripts/smoke-m003-media.mjs",
    "smoke:kodi:m004-video": "node scripts/smoke-m004-video.mjs",
    "verify:no-tailwind": "node scripts/verify-no-tailwind.mjs",
    "verify:i18n": "node scripts/verify-i18n.mjs",
    "verify:kodi-package": "node scripts/verify-kodi-package.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run verify:no-tailwind && npm run verify:i18n && npm run package:kodi:dist && npm run verify:kodi-package && npm run package:kodi:repo:dist"
  },
  "dependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-svelte": "^2.46.0",
    "globals": "^15.0.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.3.0",
    "prettier-plugin-svelte": "^3.2.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
